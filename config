[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Charishmasree/Omnisight-.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[remote "team"]
	url = https://github.com/BoogeMan-lab/OmniSight.git
	fetch = +refs/heads/*:refs/remotes/team/*
[branch "feature/ai-vision"]
	vscode-merge-base = origin/main
